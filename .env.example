# Use a dedicated password-protected database user. URL-encode password characters.
DATABASE_URL="mysql://plyli:change-me@127.0.0.1:3306/plyli_dev"
# Integration tests require a separate database ending in _test.
TEST_DATABASE_URL="mysql://plyli_test:change-me@127.0.0.1:3306/plyli_test"
# Set this to the actual origin used to run the app.
BETTER_AUTH_URL="http://localhost:3000"
# Generate a strong secret; never commit it.
BETTER_AUTH_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# Register <BETTER_AUTH_URL>/api/auth/callback/google with Google.

# Encrypted backups: preserve this key separately from encrypted files.
PLYLI_BACKUP_KEY=""
# Use an absolute path outside the source checkout.
# PLYLI_BACKUP_DIR="/absolute/path/to/plyli-backups"
PLYLI_BACKUP_RETENTION_DAYS="7"
# Defaults to mysql/mysqldump on PATH; override for your installation if needed.
# PLYLI_MYSQL_BIN="/absolute/path/to/mysql"
# PLYLI_MYSQLDUMP_BIN="/absolute/path/to/mysqldump"
