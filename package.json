{
  "name": "plyli",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "pnpm sdk:package && pnpm api:spec && next dev",
    "build": "pnpm sdk:package && pnpm api:spec && prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "pnpm sdk:sync && pnpm --filter @plyli/sdk build && tsc --noEmit",
    "test": "tsx --test lib/form-engine.test.ts tests/contracts.test.ts tests/conflicts.test.ts tests/reference.test.ts",
    "test:integration": "pnpm sdk:sync && pnpm --filter @plyli/sdk build && node scripts/integration-tests.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "api:spec": "tsx scripts/openapi.ts",
    "sdk:sync": "tsx scripts/sync-sdk.ts",
    "db:retention": "node --env-file=.env --import tsx scripts/retention.ts",
    "backup:create": "node --env-file=.env --import tsx scripts/backup.ts create",
    "backup:verify": "node --env-file=.env --import tsx scripts/backup.ts verify",
    "backup:restore-test": "node --env-file=.env --import tsx scripts/backup.ts restore-test",
    "postinstall": "prisma generate",
    "sdk:package": "pnpm sdk:sync && pnpm --filter @plyli/sdk pack --pack-destination ./public/downloads",
    "test:sdk": "pnpm sdk:sync && pnpm --filter @plyli/sdk build && pnpm --filter @plyli/sdk test",
    "maintenance": "node --env-file=.env --import tsx scripts/maintenance.ts",
    "test:consumer": "pnpm sdk:package && tsx scripts/test-sdk-consumer.ts",
    "test:docs": "pnpm sdk:sync && pnpm --filter @plyli/sdk build && pnpm api:spec && tsx scripts/test-api-examples.ts"
  },
  "engines": {
    "node": ">=22.14 <23 || >=24"
  },
  "packageManager": "pnpm@10.25.0",
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.16",
    "@prisma/client": "6.19.3",
    "autoprefixer": "^10.4.21",
    "better-auth": "1.7.16",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "15.5.29",
    "postcss": "8.5.32",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.29",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "description": "Plyli form builder, API and standalone TypeScript engine",
  "license": "MIT"
}
