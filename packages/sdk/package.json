{
  "name": "@plyli/sdk",
  "version": "0.2.0",
  "description": "Typed Plyli HTTP client and standalone form engine",
  "type": "module",
  "private": true,
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/client.test.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^22"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.25.0",
  "license": "MIT"
}
